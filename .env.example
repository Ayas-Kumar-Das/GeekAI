# =============================================================================
# GeekAI Root Environment Configuration
# =============================================================================
# Copy this file to .env or use the respective service .env files:
#   backend/.env
#   face-checkin/.env

# --- PostgreSQL Database (with pgvector) ---
DATABASE_URL=postgresql+asyncpg://geekai:geekai123@localhost:5432/geekai
POSTGRES_USER=geekai
POSTGRES_PASSWORD=geekai123
POSTGRES_DB=geekai

# --- Security & JWT ---
SECRET_KEY=change-me-to-a-secure-random-key-in-production-min32chars
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- SMTP (Optional email delivery for QR codes) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@geekai.in
SMTP_USE_TLS=true

# --- Upload Directory ---
UPLOAD_DIR=uploads

# --- Initial Seed Admin ---
SEED_ADMIN_EMAIL=admin@geekai.in
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=System Admin

# --- Face Check-in Local Application ---
API_URL=http://localhost:8000
VOLUNTEER_EMAIL=volunteer@geekai.in
VOLUNTEER_PASSWORD=volunteer123
CAMERA_INDEX=0
MATCH_THRESHOLD=0.4
SYNC_INTERVAL=300
MODEL_NAME=buffalo_l

