# =============================================================================
# GeekAI Backend — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.

# PostgreSQL (with pgvector extension installed)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/geekai

# JWT
SECRET_KEY=change-me-to-a-random-secret-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# SMTP (optional — leave blank to skip email sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@geekai.in
SMTP_USE_TLS=true

# File uploads
UPLOAD_DIR=uploads

# Seed admin credentials (used by POST /api/auth/seed)
SEED_ADMIN_EMAIL=admin@geekai.in
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=System Admin
